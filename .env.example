# Get a free-plan Groq key at https://console.groq.com/keys
# Copy this file to .env and paste your key there. Never commit .env.
# API models: GPT-OSS 120B / 20B and Qwen3.8 27B
GROQ_API_KEY=

# Google AI Studio: https://aistudio.google.com/api-keys
# Keep the project on the Free tier. This app cannot verify your billing tier.
# This spelling matches the existing project .env.
GOOGLEAI_API_KEY=

# OpenRouter: https://openrouter.ai/settings/keys
# Only specific :free models are enabled, with zero-price provider limits.
OPENROUTER_API_KEY=
