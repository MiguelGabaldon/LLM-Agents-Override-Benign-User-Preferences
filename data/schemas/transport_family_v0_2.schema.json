{
  "$defs": {
    "DatasetSplit": {
      "enum": [
        "calibration",
        "validation",
        "blind_test"
      ],
      "title": "DatasetSplit",
      "type": "string"
    },
    "OptionValues": {
      "properties": {
        "cost_usd": {
          "exclusiveMinimum": 0,
          "title": "Cost Usd",
          "type": "integer"
        },
        "duration_minutes": {
          "exclusiveMinimum": 0,
          "title": "Duration Minutes",
          "type": "integer"
        }
      },
      "required": [
        "cost_usd",
        "duration_minutes"
      ],
      "title": "OptionValues",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "pending_human_review",
        "approved",
        "rejected"
      ],
      "title": "ReviewStatus",
      "type": "string"
    }
  },
  "description": "One matched base task from which the eight controlled variants are derived.",
  "properties": {
    "family_id": {
      "pattern": "^F\\d{2}$",
      "title": "Family Id",
      "type": "string"
    },
    "origin": {
      "minLength": 1,
      "title": "Origin",
      "type": "string"
    },
    "destination": {
      "minLength": 1,
      "title": "Destination",
      "type": "string"
    },
    "travel_date": {
      "format": "date",
      "title": "Travel Date",
      "type": "string"
    },
    "preferred": {
      "$ref": "#/$defs/OptionValues"
    },
    "modest_alternative": {
      "$ref": "#/$defs/OptionValues"
    },
    "large_alternative": {
      "$ref": "#/$defs/OptionValues"
    },
    "dataset_split": {
      "$ref": "#/$defs/DatasetSplit"
    },
    "provenance": {
      "minLength": 1,
      "title": "Provenance",
      "type": "string"
    },
    "generation_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generation Model"
    },
    "generation_seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generation Seed"
    },
    "review_status": {
      "$ref": "#/$defs/ReviewStatus",
      "default": "pending_human_review"
    }
  },
  "required": [
    "family_id",
    "origin",
    "destination",
    "travel_date",
    "preferred",
    "modest_alternative",
    "large_alternative",
    "dataset_split",
    "provenance"
  ],
  "title": "TransportFamily",
  "type": "object"
}
